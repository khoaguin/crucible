        <mxCell id="k6t" value="&lt;b&gt;Infra operator logs into the VM or swaps the container image&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9fb0c3&quot;&gt;no SSH, debug-disabled, image digest pinned fail-closed&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=11;" vertex="1" parent="1">
