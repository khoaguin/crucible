        </mxCell>
        <mxCell id="k11t" value="&lt;b&gt;A lab harvests the other lab&#39;s completions (distillation)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9fb0c3&quot;&gt;members answer blind; only the neutral synthesizer reads both answers, in-enclave&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=11;" vertex="1" parent="1">
