        </mxCell>
        <mxCell id="e1" value="E1 — Main finding · the case study (K=1)" style="swimlane;startSize=44;html=1;fillColor=#0a0f1c;strokeColor=#a78bfa;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=14;fontStyle=1;align=left;spacingLeft=16;pointerEvents=0;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="640" height="610" as="geometry" />
        </mxCell>
        <mxCell id="e1tag" value="load-bearing" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#33240a;strokeColor=#e8b339;fontColor=#e8b339;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="e1">
          <mxGeometry x="470" y="8" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="e1runs" value="&lt;div style=&quot;line-height:170%;&quot;&gt;&lt;span style=&quot;color:#9fb0c3;letter-spacing:1px;&quot;&gt;RUNS&lt;/span&gt;&lt;br&gt;~100–150 prompts — authored scam + medical sets&lt;br&gt;scaled up · MultiJail backbone kept&lt;br&gt;benign over-refusal controls kept&lt;br&gt;EN + VN pairs · per-prompt provenance&lt;br&gt;6–10 models — qwen2.5 (0.5b, 3b) · phogpt-4b ·&lt;br&gt;seallm-v3-7b · vistral · gemma-2/3 · llama-3.x&lt;br&gt;3 seeds · mean ± CI · bootstrapped EN↔VN gap&lt;br&gt;judge validated against human labels on a&lt;br&gt;~100-response subset · Cohen's κ reported&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#8b98ab;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="e1">
          <mxGeometry x="20" y="56" width="600" height="248" as="geometry" />
        </mxCell>
        <mxCell id="e1fix" value="&lt;div style=&quot;line-height:170%;&quot;&gt;&lt;span style=&quot;color:#d7b357;letter-spacing:1px;&quot;&gt;VALIDITY FIXES (MANDATORY)&lt;/span&gt;&lt;br&gt;per-model template correctness in the EN arm&lt;br&gt;rubric separates coherent refusal from&lt;br&gt;degenerate output&lt;br&gt;pinned judge snapshot · matched quantization&lt;br&gt;detect_language() recorded in the Scorecard&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e250f;strokeColor=#d7b357;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="e1">
          <mxGeometry x="20" y="320" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e1del" value="&lt;div style=&quot;line-height:170%;&quot;&gt;&lt;span style=&quot;color:#a78bfa;letter-spacing:1px;&quot;&gt;&lt;b&gt;DELIVERABLE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;the citable table the hackathon's&lt;br&gt;47-prompt run only gestured at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;strokeWidth=2;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="e1">
          <mxGeometry x="20" y="496" width="600" height="90" as="geometry" />
