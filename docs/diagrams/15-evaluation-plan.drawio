        <mxCell id="e2" value="E2 — Two-sided showcases (K=2–3 · M=1–2)" style="swimlane;startSize=44;html=1;fillColor=#0a0f1c;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=14;fontStyle=1;align=left;spacingLeft=16;pointerEvents=0;rounded=1;arcSize=4;" vertex="1" parent="1">
