        <mxCell id="e2tag" value="additive" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#8b98ab;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="e2">
          <mxGeometry x="470" y="8" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="e2runs" value="&lt;div style=&quot;line-height:170%;&quot;&gt;&lt;span style=&quot;color:#9fb0c3;letter-spacing:1px;&quot;&gt;RUNS&lt;/span&gt;&lt;br&gt;1–2 audits · 2–3 benchmark owners stake private&lt;br&gt;prompt sets; 2 labs stake private models&lt;br&gt;up to 6 parties — 3 set owners, 2 labs, the auditor&lt;br&gt;three passes: Model 1, Model 2, Fusion([1, 2])&lt;br&gt;over the same sets, seeds and temperature&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#8b98ab;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="e2">
          <mxGeometry x="20" y="56" width="600" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e2score" value="&lt;div style=&quot;line-height:170%;&quot;&gt;&lt;span style=&quot;color:#2dd4bf;letter-spacing:1px;&quot;&gt;WHAT THE SCORECARD CARRIES&lt;/span&gt;&lt;br&gt;a candidates × sets grid + lift[j] per lab&lt;br&gt;per-set scores sealed to their owners&lt;br&gt;labs see only their own model, the Fusion, lift[j]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="e2">
