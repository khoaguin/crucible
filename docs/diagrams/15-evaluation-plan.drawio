        <mxCell id="title" value="Evaluation plan — what each experiment has to prove" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=17;fontColor=#dbe4f0;fontStyle=1;" vertex="1" parent="1">
