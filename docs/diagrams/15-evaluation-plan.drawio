        <mxCell id="e2note" value="&lt;div style=&quot;line-height:170%;&quot;&gt;one new mechanism —&lt;br&gt;the candidate loop&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a0f1c;strokeColor=#8b98ab;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;dashed=1;" vertex="1" parent="e2">
