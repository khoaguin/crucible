        <mxCell id="title" value="One file per dependency — where upstream drift can and cannot reach" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=17;fontColor=#dbe4f0;fontStyle=1;" vertex="1" parent="1">
