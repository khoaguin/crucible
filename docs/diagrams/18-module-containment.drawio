        <mxCell id="panel" value="the two backends — and the harness that binds them" style="swimlane;startSize=34;fillColor=#1a2233;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;fontStyle=1;html=1;align=left;spacingLeft=8;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1136" y="100" width="414" height="646" as="geometry" />
        </mxCell>
        <mxCell id="p_url4" value="Url4Backend — the default&#xa;&#xa;· runs the url4 engine in-process (Url4Node)&#xa;· per-route upstreams — one handler per owner&#xa;· outbound=StaticIOLayer() denies every fetch&#xa;&amp;nbsp;&amp;nbsp;except the declared routes&#xa;· compiled expression text gives provenance&#xa;&amp;nbsp;&amp;nbsp;natively" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#221a33;strokeColor=#a78bfa;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="panel">
          <mxGeometry x="16" y="48" width="382" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p_harness" value="equivalence harness&#xa;same spec · same inputs · mock server&#xa;→ identical per-case records through BOTH&#xa;gates every Url4Backend change" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#0a2b1e;strokeColor=#34d399;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="panel">
          <mxGeometry x="16" y="246" width="382" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p_naive" value="NaiveBackend — oracle &amp; fallback&#xa;&#xa;· ~50–100 lines&#xa;· asyncio.gather fan-out&#xa;· plain-Python reduce (single / vote / synthesize)&#xa;· zero engine imports" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="panel">
          <mxGeometry x="16" y="381" width="382" height="160" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#34d399;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="panel" source="p_url4" target="p_harness">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#34d399;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="panel" source="p_harness" target="p_naive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_cost" value="fallback is real, not theoretical — the harness is what proves it" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;spacingLeft=10;fillColor=#0a0f1c;strokeColor=#34d399;fontColor=#9fe6c6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="panel">
          <mxGeometry x="16" y="566" width="382" height="64" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="where drift cannot reach: no other file in the tree imports url4 or knows a url4 config shape. The two arrows above are the complete set of entry points." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;spacingLeft=12;fillColor=#0a0f1c;strokeColor=#8b98ab;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="770" width="1520" height="46" as="geometry" />
