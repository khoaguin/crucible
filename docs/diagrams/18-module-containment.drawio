        </mxCell>
        <mxCell id="subtitle" value="the layout is the argument: each external dependency touches exactly one file, so the blast radius of upstream drift is one file" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=12;fontColor=#9fb0c3;" vertex="1" parent="1">
