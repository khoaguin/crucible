        <mxCell id="b3b" value="Needs P1's enclave and P2's content.&lt;br&gt;&lt;br&gt;Both must already hold — running the full&lt;br&gt;grid before then just burns compute on a&lt;br&gt;stack that may still move." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#8b98ab;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b3">
