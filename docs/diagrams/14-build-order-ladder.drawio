        <mxCell id="b3a" value="&lt;b&gt;P3 — the numbers&lt;/b&gt;&lt;br&gt;&lt;br&gt;full E1 (all models × 3 seeds)&lt;br&gt;on the CVM&lt;br&gt;judge validation (Cohen's κ)&lt;br&gt;E3 measurements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b3">
