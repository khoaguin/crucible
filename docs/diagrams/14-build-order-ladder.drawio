        <mxCell id="b5a" value="&lt;b&gt;P5 — the paper&lt;/b&gt;&lt;br&gt;&lt;br&gt;writing&lt;br&gt;threat-model section&lt;br&gt;internal review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e250f;strokeColor=#d7b357;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b5">
