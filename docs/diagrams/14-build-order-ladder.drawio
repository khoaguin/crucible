        <mxCell id="b4b" value="Additive, not load-bearing.&lt;br&gt;&lt;br&gt;The paper survives without either one —&lt;br&gt;so neither may block anything above." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#151d2b;strokeColor=#6b7688;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b4">
