        <mxCell id="b0a" value="&lt;b&gt;P0 — foundation&lt;/b&gt;&lt;br&gt;&lt;br&gt;two tracks, one meeting point&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9fb0c3&quot;&gt;everything on one laptop,&lt;br&gt;no cloud, no CVM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b0">
