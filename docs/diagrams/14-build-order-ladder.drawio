        <mxCell id="b4a" value="&lt;b&gt;P4 — the showcases&lt;/b&gt;&lt;br&gt;&lt;br&gt;notebook B (AuditJob facade)&lt;br&gt;two-sided E2 + synthesize&lt;br&gt;H100 confidential-GPU demo run" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#151d2b;strokeColor=#6b7688;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b4">
