        </mxCell>
        <mxCell id="b5b" value="Last only as a &lt;i&gt;finish&lt;/i&gt;.&lt;br&gt;&lt;br&gt;The threat-model notes accrete from P1&lt;br&gt;onward — they are not written here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#8b98ab;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b5">
