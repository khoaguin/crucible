        <mxCell id="b5c" value="✓ draft → co-author review → submit to the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nearest top-tier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a2b1e;strokeColor=#34d399;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="b5">
          <mxGeometry x="726" y="12" width="402" height="94" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Ordering principle: retire the riskiest assumption first. P0 splits because its two risks are independent — can the trust protocol be stated and verified, and does the engine execute what we claim? P1 then carries the one real systems risk: does the whole stack run attested? Everything below is content, measurement and polish. No rung here is a date — a rung is done when its Verify column is true.&#xa;&#xa;Not rungs, deliberately: the related-work sweep (KHO-6) and the GCP quota request (KHO-5) run alongside and block nothing — on the ladder they only made it lie about its own critical path." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#0a0f1c;strokeColor=#8b98ab;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1390" width="1140" height="112" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
