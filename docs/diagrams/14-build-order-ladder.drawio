        <mxCell id="b4opt" value="OPTIONAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#131a26;strokeColor=#4a5568;fontColor=#8b98ab;fontFamily=Courier New;fontSize=10;fontStyle=1;" vertex="1" parent="b4">
