<mxfile host="drawio"><diagram name="two-sided"><mxGraphModel background="#0a0f1c"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Two-sided audit — the same K sets, three passes, one Scorecard grid" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="34" as="geometry"/></mxCell><mxCell id="orgK2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="104" width="280" height="96" as="geometry"/></mxCell><mxCell id="orgK1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="112" width="280" height="96" as="geometry"/></mxCell><mxCell id="orgs" value="Benchmark Orgs A · B · C (DO)&#xa;stake: private prompt sets&#xa;sends: K sets, encrypted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="96" as="geometry"/></mxCell><mxCell id="lab1" value="Lab 1 (DO)&#xa;stakes: Model 1 weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="280" height="80" as="geometry"/></mxCell><mxCell id="lab2" value="Lab 2 (DO)&#xa;stakes: Model 2 weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="280" height="80" as="geometry"/></mxCell><mxCell id="aud" value="Auditor (DS)&#xa;stakes: eval code + synthesizer s&#xa;(open weights, digest-pinned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#9fb0c3;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="280" height="100" as="geometry"/></mxCell><mxCell id="enc" value="ENCLAVE — three passes over the same K sets · seeds 11,17,23 · temperature 0" style="swimlane;startSize=34;fillColor=#0a2b1e;strokeColor=#34d399;fontColor=#dbe4f0;fontFamily=Courier New;fontSize=13;fontStyle=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="840" height="690" as="geometry"/></mxCell><mxCell id="lane1" value="PASS 1 — candidate: Model 1   (reduce=single)" style="swimlane;startSize=26;fillColor=#0f1626;strokeColor=#3b4a63;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=12;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="800" height="190" as="geometry"/></mxCell><mxCell id="lane2" value="PASS 2 — candidate: Model 2   (reduce=single)" style="swimlane;startSize=26;fillColor=#0f1626;strokeColor=#3b4a63;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=12;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="420" y="315" width="800" height="190" as="geometry"/></mxCell><mxCell id="lane3" value="PASS 3 — candidate: Fusion([Model 1, Model 2])   (reduce=synthesize)" style="swimlane;startSize=26;fillColor=#0f1626;strokeColor=#3b4a63;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=12;fontStyle=1;align=left;spacingLeft=10;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="800" height="190" as="geometry"/></mxCell><mxCell id="s1" value="K sets&#xa;A · B · C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#221a33;strokeColor=#a78bfa;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="130" height="90" as="geometry"/></mxCell><mxCell id="m1" value="Model 1" style="rounded=1;whiteSpace=wrap;html=1;