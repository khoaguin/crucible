ue="Model 1&#xa;(blind)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="556" width="130" height="55" as="geometry"/></mxCell><mxCell id="m32" value="Model 2&#xa;(blind)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="634" width="130" height="55" as="geometry"/></mxCell><mxCell id="syn" value="synthesizer s&#xa;the ONLY place both&#xa;labs' answers meet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33240a;strokeColor=#e8b339;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="745" y="570" width="155" height="100" as="geometry"/></mxCell><mxCell id="g3" value="grader&#xa;/judge&#xa;final answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#9fb0c3;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="915" y="575" width="120" height="90" as="geometry"/></mxCell><mxCell id="r3" value="Fusion:&#xa;per_set[A,B,C]&#xa;+ combined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a2b1e;strokeColor=#34d399;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="575" width="145" height="90" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#a78bfa;fontColor=#a78bfa;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="m31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#a78bfa;fontColor=#a78bfa;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="m32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#2dd4bf;fontColor=#2dd4bf;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;entryX=0;entryY=0.3;" edge="1" parent="1" source="m31" target="syn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#2dd4bf;fontColor=#2dd4bf;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;entryX=0;entryY=0.7;" edge="1" parent="1" source="m32" target="syn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#e8b339;fontColor=#e8b339;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="syn" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="g3" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="sets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#a78bfa;fontColor=#a78bfa;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;exitX=1;exitY=0.5;entryX=0;entryY=0.157;" edge="1" parent="1" source="orgs" target="enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="weights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#2dd4bf;fontColor=#2dd4bf;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;exitX=1;exitY=0.5;entryX=0;entryY=0.377;" edge="1" parent="1" source="lab1" target="enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="weights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#2dd4bf;fontColor=#2dd4bf;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;exitX=1;exitY=0.5;entryX=0;entryY=0.536;" edge="1" parent="1" source="lab2" target="enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="code + s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#9fb0c3;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;exitX=1;exitY=0.5;entryX=0;entryY=0.739;" edge="1" parent="1" source="aud" target="enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sc" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Scorecard&lt;/b&gt; — signed, fixed schema, the only output&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-family:Courier New;font-size:12px;color:#dbe4f0;border-collapse:collapse&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;A&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;B&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;C&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;combined&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;Model 1&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;Model 2&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;Fusion&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;td style=&quot;width:70px;padding:3px 0&quot;&gt;■&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;lift[1] = Fusion − Model 1 (paired CI)&lt;br&gt;lift[2] = Fusion − Model 2 (paired CI)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33240a;strokeColor=#e8b339;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="110" width="420" height="300" as="geometry"/></mxCell><mxCell id="ds" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;disclosure — private mode&lt;/b&gt;&lt;br&gt;&lt;br&gt;org i → per_set[i] + combined,&lt;br&gt;&amp;nbsp;&amp;nbsp;for every candidate&lt;br&gt;lab j → own model + Fusion combined,&lt;br&gt;&amp;nbsp;&amp;nbsp;plus lift[j]&lt;br&gt;auditor → every combined + every lift&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#e06c75&quot;&gt;never: a lab sees the other lab's&lt;br&gt;standalone score or completions&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#e06c75;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="460" width="420" height="250" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#34d399;fontColor=#34d399;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="r1" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#34d399;fontColor=#34d399;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r2" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#34d399;fontColor=#34d399;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="r3" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="sealed per party" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#e8b339;fontColor=#e8b339;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sc" target="ds"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
