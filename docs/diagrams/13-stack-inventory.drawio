  <diagram name="stack-inventory">
    <mxGraphModel background="#0a0f1c">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="The stack Crucible consumes — and the two places we don't just consume it" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=17;fontColor=#dbe4f0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1184" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Crucible is a consumer, not a platform. Green = take it as it ships. Amber = the default is not safe enough. Red = nobody built it yet." style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#9fb0c3;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1184" height="16" as="geometry" />
        </mxCell>
