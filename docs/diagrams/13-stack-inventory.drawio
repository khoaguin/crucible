        <mxCell id="c2h0" value="REAL TODAY" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=9;fontColor=#9fb0c3;fontStyle=1;" vertex="1" parent="c2">
          <mxGeometry x="14" y="80" width="352" height="12" as="geometry" />
        </mxCell>
        <mxCell id="c2b0" value="· url4 1.4.1 + screamingface 0.1.1.post7&#xa;&#160;&#160;on PyPI — Crucible pins both exactly&#xa;&#160;&#160;(the wheel vendors engine, aigateway, url4)&#xa;· repo: screamingface-engine 1.5.0, aigateway 0.2.1&#xa;· Fusion → URL4 compile → engine dispatch&#xa;· LiteLLM-compatible gateway&#xa;· screamingface up runs the local stack" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#dbe4f0;fontStyle=0;" vertex="1" parent="c2">
          <mxGeometry x="14" y="96" width="352" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c2h1" value="WHAT WE DO" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=9;fontColor=#2dd4bf;fontStyle=1;" vertex="1" parent="c2">
          <mxGeometry x="14" y="209" width="352" height="12" as="geometry" />
        </mxCell>
        <mxCell id="c2b1" value="Run url4 in-process inside the enclave;&#xa;its routes reach only local model servers —&#xa;no external fetch on the url4 path." style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#dbe4f0;fontStyle=0;" vertex="1" parent="c2">
          <mxGeometry x="14" y="225" width="352" height="45" as="geometry" />
        </mxCell>
