        <mxCell id="c1h0" value="REAL TODAY" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=9;fontColor=#9fb0c3;fontStyle=1;" vertex="1" parent="c1">
          <mxGeometry x="14" y="80" width="352" height="12" as="geometry" />
        </mxCell>
        <mxCell id="c1b0" value="· Confidential Space terraform, incl. GPU deploys&#xa;· EAT-JWT attestation over a Unix socket&#xa;· N-party unanimous approval (data_owners: list)&#xa;· job runner: unconfined subprocess; the seccomp&#xa;&#160;&#160;sandbox is on an unmerged branch&#xa;· end-to-end Gemma demo" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#dbe4f0;fontStyle=0;" vertex="1" parent="c1">
          <mxGeometry x="14" y="96" width="352" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c1h1" value="WHAT WE DO" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=9;fontColor=#2dd4bf;fontStyle=1;" vertex="1" parent="c1">
          <mxGeometry x="14" y="209" width="352" height="12" as="geometry" />
        </mxCell>
        <mxCell id="c1b1" value="Image-digest pinning is opt-in upstream;&#xa;Crucible makes it mandatory.&#xa;Two open gaps: attestation-token freshness&#xa;(expired tokens accepted for 30 days) and&#xa;network egress (job sandbox not merged)." style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#dbe4f0;fontStyle=0;" vertex="1" parent="c1">
          <mxGeometry x="14" y="225" width="352" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#34d399;strokeWidth=2;arcSize=6;fontFamily=Courier New;" vertex="1" parent="1">
