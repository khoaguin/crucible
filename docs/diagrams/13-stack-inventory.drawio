          <mxGeometry x="14" y="278" width="352" height="12" as="geometry" />
        </mxCell>
        <mxCell id="c3b2" value="Crucible builds BenchmarkSpec + a one-file&#xa;config-emitter, and upstreams what it learns." style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#dbe4f0;fontStyle=0;" vertex="1" parent="c3">
