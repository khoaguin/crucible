<mxfile host="drawio"><diagram name="asks"><mxGraphModel background="#0a0f1c"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Upstream asks — the tape Crucible carries today, and what it becomes upstream" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="34" as="geometry"/></mxCell><mxCell id="L1" value="TODAY — Crucible tapes over upstream gaps from outside; two gaps it cannot tape stay open" style="swimlane;startSize=34;fillColor=#140a0d;strokeColor=#f87171;fontColor=#f87171;fontFamily=Courier New;fontSize=14;fontStyle=1;align=left;spacingLeft=12;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1620" height="300" as="geometry"/></mxCell><mxCell id="L2" value="AFTER — 13 asks land upstream; Crucible deletes its tape, and every PySyft / SF user gets the fix" style="swimlane;startSize=34;fillColor=#08150f;strokeColor=#34d399;fontColor=#34d399;fontFamily=Courier New;fontSize=14;fontStyle=1;align=left;spacingLeft=12;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1620" height="300" as="geometry"/></mxCell><mxCell id="a1" value="🤖 Crucible audit&#xa;K orgs + M labs + auditor&#xa;&#xa;pinned:&#xa;syft-enclave 0.1.1&#xa;screamingface 0.1.1.post7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="280" height="200" as="geometry"/></mxCell><mxCell id="a2" value="⚠️ tape we carry in our own code&#xa;&#xa;· own Url4Node + StaticIOLayer&#xa;· own per-party Scorecard sealing&#xa;· own TDX CPU terraform patch&#xa;· url4 pin silently overwritten&#xa;by the screamingface wheel&#xa;· pins lack dev's approval and&#xa;key-binding fixes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33240a;strokeColor=#e8b339;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="340" height="220" as="geometry"/></mxCell><mxCell id="a3" value="⚠️ still OPEN — no tape reaches it&#xa;&#xa;threat #10 — network egress:&#xa;jobs run as an unconfined&#xa;bash run.sh subprocess&#xa;&#xa;threat #7 — stale token replay:&#xa;no fresh verifier nonce,&#xa;30-day grace on expired tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e1013;strokeColor=#f87171;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="320" height="220" as="geometry"/></mxCell><mxCell id="a4" value="every other PySyft / SF user&#xa;&#xa;hits the same traps —&#xa;without the tape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2233;strokeColor=#9fb0c3;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1310" y="130" width="280" height="200" as="geometry"/></mxCell><mxCell id="e1" value="patch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#e8b339;fontColor=#e8b339;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="unpatchable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#f87171;fontColor=#f87171;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="same bugs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9fb0c3;fontColor=#9fb0c3;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="13 asks filed&#xa;P1–P6 PySyft · S1–S7 ScreamingFace&#xa;&#xa;we send the PR for&#xa;P2 · P6 · S3 · S4 · S6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c2530;strokeColor=#2dd4bf;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="280" height="200" as="geometry"/></mxCell><mxCell id="b2" value="Crucible deletes its tape&#xa;&#xa;· pin == what runs&#xa;· url4 builds safe nodes itself&#xa;· syft routes results per party&#xa;· TDX is a terraform variable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a2b1e;strokeColor=#34d399;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="340" height="220" as="geometry"/></mxCell><mxCell id="b3" value="0 open gaps&#xa;&#xa;threat #10 closed:&#xa;the sandbox denies socket()&#xa;&#xa;threat #7 closed:&#xa;the token carries the&#xa;verifier's nonce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a2b1e;strokeColor=#34d399;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="320" height="220" as="geometry"/></mxCell><mxCell id="b4" value="✅ every PySyft / SF user&#xa;gets the same fixes&#xa;&#xa;no tape required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a2b1e;strokeColor=#34d399;fontFamily=Courier New;fontColor=#dbe4f0;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1310" y="470" width="280" height="200" as="geometry"/></mxCell><mxCell id="e4" value="releases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#34d399;fontColor=#34d399;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="re-run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#34d399;fontColor=#34d399;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="shipped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#34d399;fontColor=#34d399;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#0a0f1c;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
